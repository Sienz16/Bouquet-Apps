<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BouquetBliss" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/pink_light</item>
        <item name="colorPrimaryVariant">@color/pink_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/pink_medium</item>
        <item name="colorSecondaryVariant">@color/pink_light</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <!-- Surface colors for dark mode -->
        <item name="colorSurface">#1F1F1F</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorOnBackground">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/pink_primary</item>
        <!-- Material Component colors -->
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/pink_light</item>
        <item name="colorControlHighlight">@color/ripple_color</item>
    </style>
</resources>
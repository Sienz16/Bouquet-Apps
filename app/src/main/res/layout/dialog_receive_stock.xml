<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Receive new stock delivery"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp" />

    <!-- Quantity Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity to receive"
            android:inputType="number"
            android:drawableStart="@android:drawable/ic_input_add"
            android:drawablePadding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Reason Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/pink_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reason (optional)"
            android:inputType="textCapSentences"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This will add the specified quantity to the current stock level."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:alpha="0.8" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permissions for image upload -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- For devices running Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BouquetBliss">
        <!-- Login Activity as main launcher -->
        <activity
            android:name=".common.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.BouquetBliss.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dashboard Activities -->
        <activity
            android:name=".admin.dashboard.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".admin.profile.AdminProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".admin.orders.AdminOrderManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".user.dashboard.UserDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".user.browse.BrowseBouquetsActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".user.detail.BouquetDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".user.orders.UserOrdersActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <!-- Registration Activity -->
        <activity
            android:name=".common.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <!-- Stock Management Activities -->
        <activity
            android:name=".admin.stock.StockManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".admin.stock.AddEditBouquetActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <activity
            android:name=".BouquetDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.BouquetBliss.NoActionBar" />

        <!-- Original MainActivity (for future use) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name" />
    </application>

</manifest>